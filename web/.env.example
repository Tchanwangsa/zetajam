# Where the websocket hub lives. Leave this unset when the Go binary is serving
# the frontend itself — the app then talks to its own origin, which is right in
# development and right for the single-binary build.
#
# Set it when the page is hosted apart from the server, e.g. Cloudflare Pages
# for the page and Cloud Run for the socket. ws:// and wss:// are both accepted,
# and so is an https:// URL, which gets rewritten to wss://. The /ws path is
# appended for you.
#
# The server has to allow the page's origin back — see ORIGINS in the Dockerfile
# notes and server/main.go.
VITE_WS_URL=https://zetajam-xxxxxxxx-uc.a.run.app

# The public address of the page. Everything a crawler or a social scraper
# reads is built from it — the canonical link, the og:/twitter: tags, the
# JSON-LD, robots.txt and sitemap.xml — and all of those need an absolute URL,
# because a scraper is never on this origin.
#
# vite.config.ts has a default, so this only needs setting when the page ships
# somewhere other than its usual home. A trailing slash is fine either way.
VITE_SITE_URL=https://zetajam.example.com

# The Google Analytics measurement ID. It is a public identifier, not a secret,
# and vite.config.ts already defaults to the real one, so this only needs
# setting to point a fork or a staging build at a different property. Set it to
# an empty string to build with no analytics tag at all.
#
# The tag is only injected by `vite build` — the dev server never loads it.
VITE_GA_ID=G-JM0R2CY4NC
